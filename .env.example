# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Cloud Messaging VAPID Key (Required for push notifications)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_here

# Google Maps API Key (Required for location features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# PWA and Offline Configuration
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# GPS Configuration
NEXT_PUBLIC_GPS_TIMEOUT=15000

# Camera Configuration (0.1 to 1.0, where 1.0 is highest quality)
NEXT_PUBLIC_CAMERA_QUALITY=0.8

# Google Genkit AI Configuration
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here

# EmailJS Configuration (move these to environment variables for security)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
NEXT_PUBLIC_EMAILJS_TEMPLATE_NUEVA_RUTA=your_template_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_RUTA_COMPLETADA=your_template_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_NUEVO_USUARIO=your_template_id
